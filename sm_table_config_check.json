{
    "Comment": "State Machine to Restore DynamoDB Table Ensuring No Orphaned Replicas Exist",
    "StartAt": "CheckTableExists",
    "States": {
      "CheckTableExists": {
        "Type": "Task",
        "Resource": "arn:aws:states:::aws-sdk:dynamodb:describeTable",
        "Parameters": {
          "TableName.$": "$.TableName"
        },
        "Catch": [
          {
            "ErrorEquals": ["DynamoDB.ResourceNotFoundException"],
            "Next": "CheckAWSConfig"
          }
        ],
        "Next": "CheckReplicasInExistingTable"
      },
  
      "CheckReplicasInExistingTable": {
        "Type": "Choice",
        "Choices": [
          {
            "Variable": "$.Table.Replicas",
            "IsPresent": true,
            "Next": "FailDueToReplicas"
          }
        ],
        "Default": "Success"
      },
  
      "CheckAWSConfig": {
        "Type": "Task",
        "Resource": "arn:aws:states:::aws-sdk:config:getResourceConfigHistory",
        "Parameters": {
          "resourceType": "AWS::DynamoDB::Table",
          "resourceId.$": "$.TableName",
          "Limit": 2
        },
        "Next": "CheckReplicasInConfig"
      },
  
      "CheckReplicasInConfig": {
        "Type": "Choice",
        "Choices": [
          {
            "Variable": "$.configurationItems[1].configuration.Replicas",
            "IsPresent": true,
            "Next": "InvokeReplicaCheckLambda"
          }
        ],
        "Default": "Success"
      },
  
      "InvokeReplicaCheckLambda": {
        "Type": "Task",
        "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:ReplicaCheckLambda",
        "Parameters": {
          "Replicas.$": "$.configurationItems[1].configuration.Replicas"
        },
        "Next": "EvaluateReplicaCheck"
      },
  
      "EvaluateReplicaCheck": {
        "Type": "Choice",
        "Choices": [
          {
            "Variable": "$.replicas_exist",
            "BooleanEquals": true,
            "Next": "FailDueToReplicas"
          }
        ],
        "Default": "Success"
      },
  
      "FailDueToReplicas": {
        "Type": "Fail",
        "Error": "ReplicasExistError",
        "Cause": "One or more replicas still exist."
      },
  
      "Success": {
        "Type": "Succeed"
      }
    }
  }
  