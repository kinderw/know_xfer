{
    "Comment": "State Machine to Test AWS Config Response Passing",
    "StartAt": "CheckTableExists",
    "States": {
      "CheckTableExists": {
        "Type": "Task",
        "Resource": "arn:aws:states:::aws-sdk:dynamodb:describeTable",
        "Parameters": {
          "TableName.$": "$.TableName"
        },
        "ResultPath": "$.DescribeTableResult",
        "Catch": [
          {
            "ErrorEquals": ["DynamoDB.ResourceNotFoundException"],
            "ResultPath": "$.ErrorInfo",
            "Next": "CheckAWSConfig"
          }
        ],
        "Next": "CheckReplicasInExistingTable"
      },
  
      "CheckReplicasInExistingTable": {
        "Type": "Choice",
        "Choices": [
          {
            "Variable": "$.DescribeTableResult.Table.Replicas",
            "IsPresent": true,
            "Next": "FailDueToReplicas"
          }
        ],
        "Default": "Success"
      },
  
      "CheckAWSConfig": {
        "Type": "Task",
        "Resource": "arn:aws:states:::aws-sdk:config:getResourceConfigHistory",
        "Parameters": {
          "resourceType": "AWS::DynamoDB::Table",
          "resourceId.$": "$.TableName",
          "Limit": 2
        },
        "ResultPath": "$.AWSConfigResponse",
        "Next": "CheckReplicasInLambda"
      },
  
      "CheckReplicasInLambda": {
        "Type": "Task",
        "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:InspectAndCheckReplicasLambda",
        "Parameters": {
          "configurationItems.$": "$.AWSConfigResponse.configurationItems"
        },
        "ResultPath": "$.ReplicaCheckResult",
        "Next": "EvaluateReplicaCheck"
      },
  
      "EvaluateReplicaCheck": {
        "Type": "Choice",
        "Choices": [
          {
            "Variable": "$.ReplicaCheckResult.replicas_exist",
            "BooleanEquals": true,
            "Next": "FailDueToReplicas"
          }
        ],
        "Default": "Success"
      },
  
      "FailDueToReplicas": {
        "Type": "Fail",
        "Error": "ReplicasExistError",
        "Cause": "One or more replicas still exist."
      },
  
      "Success": {
        "Type": "Succeed"
      }
    }
  }
  